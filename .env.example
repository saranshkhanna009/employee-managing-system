# Employee Tracking System - Docker Compose environment
# Copy this file to .env, replace every required value, and never commit .env.
# Compose intentionally fails when a required value is missing.

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
DEBUG=true
HTTP_PORT=8080
TLS_TERMINATION=external

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_NAME=employee_tracker
DB_USER=employee_user
# Use URL-safe characters; for example: openssl rand -hex 24
DB_PASSWORD=

# =============================================================================
# REDIS
# =============================================================================
# Use URL-safe characters; for example: openssl rand -hex 24
REDIS_PASSWORD=

# =============================================================================
# ENCRYPTION (CRITICAL - Generate with: openssl rand -base64 32)
# =============================================================================
# Must be 32 bytes (44 chars base64)
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_VERSION=1

# =============================================================================
# SESSION SECURITY (CRITICAL - Generate with: openssl rand -base64 32)
# =============================================================================
# Must be 32 bytes (44 chars base64)
SECRET_KEY=
# The __Host- prefix requires Secure cookies and therefore HTTPS. Use this
# local-only name for the HTTP Compose setup; restore __Host-session in HTTPS.
SESSION_COOKIE_NAME=session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=3600
SESSION_MAX_CONCURRENT=3

# =============================================================================
# CORS
# =============================================================================
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:8080"]

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/hour
RATE_LIMIT_API=100/minute
RATE_LIMIT_PASSWORD_RESET=2/hour

# =============================================================================
# PASSWORD SECURITY
# =============================================================================
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# =============================================================================
# EMAIL (for password reset)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
FROM_EMAIL=dev@employee-tracker.invalid

# =============================================================================
# SECURITY HEADERS
# =============================================================================
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
HSTS_MAX_AGE=31536000

# =============================================================================
# AUDIT
# =============================================================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555

# =============================================================================
# ADMIN ID FORMAT
# =============================================================================
ADMIN_ID_PREFIX=EMP
ADMIN_ID_FORMAT={prefix}-{company_slug}-{sequence:04d}

# =============================================================================
# FRONTEND
# =============================================================================
# This is embedded into the frontend at image build time. Use the public app
# origin when the root Nginx gateway serves both the SPA and /api/.
VITE_API_URL=http://localhost:8080
